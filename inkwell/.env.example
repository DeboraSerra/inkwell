# Copy to .env.local and fill in. Never commit real values.

# --- Firebase web app (public, sent to the browser) ---
# Firebase console → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Admin (server only, SECRET) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Keep the key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Database (server only, SECRET) ---
# Local: postgresql://postgres:postgres@localhost:5432/inkwell
# Neon: DATABASE_URL is the pooled string (host contains "-pooler"), used by the app.
#       DIRECT_URL is the direct string, used by Prisma migrations. Optional locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkwell
DIRECT_URL=
