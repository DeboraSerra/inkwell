// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trope {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Status {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  content   String?
  rating    Int
  book      Book     @relation("BookReviews", fields: [bookId], references: [id])
  bookId    String
  user      User     @relation("UserReviews", fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id        String      @id @default(uuid())
  title     String      @unique
  author    String
  image     String
  tags      String[]
  trope     Trope?      @relation(fields: [tropeId], references: [id])
  tropeId   String?
  genre     Genre?      @relation(fields: [genreId], references: [id])
  genreId   String?
  review    Review[]    @relation("BookReviews")
  status    Status?     @relation(fields: [statusId], references: [id])
  statusId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userBooks UserBooks[]
}

model User {
  id        String      @id @unique
  email     String      @unique
  name      String?
  age       Int?
  reviews   Review[]    @relation("UserReviews")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userBooks UserBooks[]
  apiTokens ApiToken[]
}

// Personal access tokens, used by the Chrome extension. Only the SHA-256 hash
// of the token is stored; the plain token is shown once when it's created.
model ApiToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model UserBooks {
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}
