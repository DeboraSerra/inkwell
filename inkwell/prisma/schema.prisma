generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users and auth
// ---------------------------------------------------------------------------

model User {
  id        String     @id @unique
  email     String     @unique
  name      String?
  age       Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  apiTokens ApiToken[]
}

// Personal access tokens, used by the Chrome extension. Only the SHA-256 hash
// of the token is stored; the plain token is shown once when it's created.
model ApiToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Shared book catalog. A book is stored once and reused by every user; each
// user's status, shelves and notes about it live in per-user tables.
// ---------------------------------------------------------------------------

enum LengthCategory {
  SHORT
  MEDIUM
  LONG
}

enum MetadataSource {
  AMAZON
  OPEN_LIBRARY
  GOOGLE_BOOKS
  MANUAL
}

// Who attached a genre or trope to a book, so AI suggestions can be told apart
// from (and never overwrite) the user's own edits.
enum TagSource {
  AI
  USER
}

model Book {
  id             String          @id @default(uuid())
  title          String
  subtitle       String?
  authors        String[]
  // Normalized title + first author; see src/lib/books/dedupe.ts. Not unique,
  // because different editions of the same book share it.
  dedupeKey      String
  isbn10         String?
  isbn13         String?         @unique
  asin           String?         @unique
  openLibraryId  String?
  googleBooksId  String?
  coverUrl       String?
  pageCount      Int?
  lengthCategory LengthCategory?
  publishedYear  Int?
  description    String?
  tags           String[]
  aiEnrichedAt   DateTime?
  metadataSource MetadataSource
  genres         BookGenre[]
  tropes         BookTrope[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([dedupeKey])
  @@index([isbn10])
}

model Genre {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  books       BookGenre[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Trope {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  books       BookTrope[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model BookGenre {
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId   String
  source    TagSource
  createdAt DateTime  @default(now())

  @@id([bookId, genreId])
  @@index([genreId])
}

model BookTrope {
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  trope     Trope     @relation(fields: [tropeId], references: [id], onDelete: Cascade)
  tropeId   String
  source    TagSource
  createdAt DateTime  @default(now())

  @@id([bookId, tropeId])
  @@index([tropeId])
}
