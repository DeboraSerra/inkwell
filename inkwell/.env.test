# The browser accessibility tests (npm run test:a11y, Phase 8b), read by e2e/env.ts.
# They're passed to the build and the server, overriding .env.local, so no real
# Firebase project, API key or database is used. Not loaded by next itself.
# Committed, so nothing here may be secret: put this machine's own values, such
# as the database's password, in .env.test.local (gitignored), which wins.

# An empty local Postgres database of its own, never the app's: the tests replace
# the test user's library. This is CI's throwaway Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkwell_e2e
DIRECT_URL=

# Built into its own folder, so the real build in .next is left alone.
NEXT_DIST_DIR=.next-e2e

# The Firebase Auth emulator (npm run e2e:emulator; the port is in e2e/firebase.json).
# A "demo-" project only exists in the emulator.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-inkwell
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-inkwell
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-inkwell.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Left empty so the values in .env.local aren't used.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Open Library then sends plain "Inkwell"; the tests look nothing up anyway.
METADATA_USER_AGENT=
CRON_SECRET=

# The test user, made fresh in the Auth emulator by e2e/global-setup.ts (or
# npm run e2e:user). It exists only there, so these are fakes, not secrets.
E2E_USER_EMAIL=reader@example.com
E2E_USER_PASSWORD=a11y-test-password
E2E_USER_NAME=Ada Reader
