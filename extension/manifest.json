{
  "name": "Inkwell Kindle import",
  "description": "Imports your Kindle library from Amazon's content page into Inkwell",
  "version": "2.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  },
  "action": {
    "default_title": "Import Kindle books to Inkwell",
    "default_icon": "icon.png"
  }
}
